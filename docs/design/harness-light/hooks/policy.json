{
  "$comment": "Politique d'accès lue par guard.mjs. 'main' = la session principale. Chaque autre clé = nom d'un subagent (.claude/agents/<nom>.md). Les chemins sont relatifs à la racine du projet, en glob (** et *). Ce fichier est protégé : seul un humain peut le modifier. Version allégée (priorité au rythme des features) : périmètres élargis, commandes npm communes à tous les agents qui codent, --fix autorisé ; les protections dures (harness, secrets, assets générés, commandes destructrices, pureté du core) sont inchangées.",

  "protected": [
    ".claude/hooks/**",
    ".claude/settings.json",
    ".claude/settings.local.json",
    ".claude/agents/**",
    ".env",
    ".env.*",
    ".git/**",
    "node_modules/**",
    "package-lock.json",
    "assets-src/**",
    "public/assets/**",
    "src/render/assets/asset-catalog.ts",
    "tools/build-assets.mjs"
  ],

  "unreadable": [".env", ".env.*", "**/*.pem", "**/*.key"],

  "bashDenyAll": [
    "\\brm\\s+-[a-z]*r",
    "\\brmdir\\b",
    "Remove-Item",
    "\\bdel\\s",
    "\\bformat\\b\\s+[a-z]:",
    "\\bsudo\\b",
    "\\bchmod\\b",
    "\\bchown\\b",
    "git\\s+push",
    "git\\s+reset\\s+--hard",
    "git\\s+clean",
    "git\\s+checkout\\s+--\\s",
    "git\\s+rebase",
    "git\\s+commit\\s+.*--no-verify",
    "git\\s+config",
    "\\bnpm\\s+publish",
    "\\bcurl\\b",
    "\\bwget\\b",
    "Invoke-WebRequest",
    "Invoke-RestMethod",
    "\\bssh\\b",
    "\\bscp\\b",
    "\\beval\\b",
    "--dangerously",
    "\\.claude[/\\\\](hooks|settings|agents)",
    "\\.env\\b"
  ],

  "bashDenySubagents": [],

  "agents": {
    "main": {
      "write": ["**"],
      "bash": "any-not-denied"
    },

    "architect": {
      "write": ["docs/**"],
      "bash": ["^git (status|diff|log|show)\\b"]
    },

    "core-dev": {
      "write": ["src/core/**", "src/data/**", "tests/**", "docs/design/**"],
      "bash": ["^npm (run )?(test|typecheck|lint|coverage|check)\\b", "^npx (vitest|tsc|eslint)\\b", "^git (status|diff|log|show)\\b"]
    },

    "render-dev": {
      "write": ["src/render/**", "src/ui/**", "src/app/**", "src/main.ts", "src/styles/**", "index.html", "public/**", "tests/**", "tools/asset-preview/**", "docs/design/**"],
      "bash": ["^npm (run )?(test|typecheck|lint|build|assets|assets:size|e2e|captures|check)\\b", "^npx (vitest|tsc|eslint|playwright test)\\b", "^git (status|diff|log|show)\\b"]
    },

    "save-guardian": {
      "write": ["src/save/**", "tests/**", "docs/design/**"],
      "bash": ["^npm (run )?(test|typecheck|lint|coverage|check)\\b", "^npx (vitest|tsc|eslint)\\b", "^git (status|diff|log|show)\\b"]
    },

    "test-writer": {
      "write": ["tests/**"],
      "bash": ["^npm (run )?(test|typecheck|lint|coverage|e2e|check)\\b", "^npx (vitest|tsc|eslint|playwright test)\\b", "^git (status|diff|log|show)\\b"]
    },

    "balance-designer": {
      "write": ["src/data/**", "tests/**", "docs/**"],
      "bash": ["^npm (run )?(test|typecheck|lint|sim|check)\\b", "^npx (vitest|tsc|eslint)\\b", "^git (status|diff|log|show)\\b"]
    },

    "reviewer": {
      "write": [],
      "bash": ["^git (status|diff|log|show)\\b", "^npm (run )?(test|typecheck|lint|check)\\b", "^npx vitest\\b"]
    }
  },

  "unknownAgent": {
    "write": [],
    "bash": []
  }
}
